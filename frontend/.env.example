# TRAZO · frontend. Configuración de desarrollo.
#
# URL base de la API que consume el cliente (`src/api/client.ts`).
#
# En desarrollo se deja VACÍA: las llamadas van a rutas relativas
# («/api/...») en el mismo origen y el proxy de Vite (vite.config.ts)
# las reenvía a FastAPI en http://localhost:8000. Sin CORS.
#
# Si prefieres llamar directamente al backend (sin proxy), descomenta y
# usa la URL absoluta; en ese caso el backend tendría que permitir CORS
# para el origen del frontend.
VITE_API_BASE_URL=
# VITE_API_BASE_URL=http://localhost:8000
